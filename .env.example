# ===========================================================================
# SI-PKL — contoh konfigurasi environment.
#
# Salin menjadi .env lalu sesuaikan:
#   cp .env.example .env
#
# JANGAN commit file .env. Semua nilai rahasia wajib diganti di produksi.
# ===========================================================================

# --- Aplikasi -------------------------------------------------------------
# URL publik yang dipakai untuk tautan reset password / email.
APP_URL=https://si-pkl.akucintacysec.online

# Kunci tanda tangan JWT. WAJIB minimal 32 karakter dan acak.
# Buat dengan: openssl rand -base64 48
AUTH_SECRET=ganti-dengan-random-string-minimal-32-karakter

# Cookie sesi hanya dikirim lewat HTTPS (default aman untuk produksi).
# Set "false" HANYA saat menguji lokal via http://localhost.
AUTH_COOKIE_SECURE=true

# Zona waktu container (opsional).
TZ=Asia/Jakarta

# --- Database MySQL -------------------------------------------------------
# Nilai ini dipakai service "mysql" di docker-compose.yml.
MYSQL_DATABASE=si_pkl
MYSQL_USER=si_pkl
MYSQL_PASSWORD=ganti_password_kuat
MYSQL_ROOT_PASSWORD=ganti_root_password_kuat

# URL koneksi Prisma.
#   - docker compose (MySQL internal) : host "mysql"
#   - MySQL di host / lokal          : host "127.0.0.1" (atau "localhost")
#   - container MySQL eksternal      : host nama container + network eksternal
# Karakter khusus pada password wajib di-URL-encode (mis. @ -> %40, # -> %23).
DATABASE_URL=mysql://si_pkl:ganti_password_kuat@mysql:3306/si_pkl

# --- Upload berkas --------------------------------------------------------
# Direktori penyimpanan foto/jurnal/laporan. Di Docker sudah diarahkan ke
# volume /app/uploads; jangan diubah kecuali Anda juga mengubah volume.
UPLOAD_DIR=/app/uploads

# --- SMTP (opsional) ------------------------------------------------------
# Tanpa SMTP, tautan reset password dicatat ke log container
# ([mail:fallback]) agar tetap bisa dipakai saat darurat.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# true untuk port 465 (implicit TLS). Port 587 biasanya false + STARTTLS.
SMTP_SECURE=false
# Set "false" hanya jika memakai sertifikat SMTP self-signed.
SMTP_REJECT_UNAUTHORIZED=true
MAIL_FROM="SI-PKL <no-reply@si-pkl.local>"

# --- Seeder (opsional) ----------------------------------------------------
# Password untuk semua akun demo saat menjalankan `prisma db seed`.
# Default "password" jika tidak diisi.
SEED_PASSWORD=password

# --- MySQL eksternal (khusus docker-compose.external-db.yml) --------------
# Nama network container MySQL yang sudah berjalan, lihat README.
EXTERNAL_DB_NETWORK=
# URL koneksi dari dalam network tersebut, mis.:
# EXTERNAL_DATABASE_URL=mysql://user:password@si_pkl_mysql:3306/si_pkl
EXTERNAL_DATABASE_URL=
